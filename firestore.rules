rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - tokens: number (required)
    //   - userTier: string (required, enum: ['free', 'pro', 'agency'])
    //   - customGeminiKey: string (optional)
    //
    // Subcollection: users/{userId}/brands
    // Document ID: {brandId}
    // Fields:
    //   - id: string
    //   - name: string
    //   - industry: string
    //   - tone: string
    //   - values: list
    //   - mission: string
    //   - targetAudience: string
    //
    // Subcollection: users/{userId}/campaigns
    // Document ID: {campaignId}
    // Fields:
    //   - id: string
    //   - title: string
    //   - description: string
    //   - objective: string
    //   - status: string
    //   - assets: list
    //
    // Subcollection: users/{userId}/leads
    // Document ID: {leadId}
    // Fields:
    //   - id: string
    //   - name: string
    //   - email: string
    //   - company: string
    //   - role: string
    //   - score: number
    //   - status: string
    //
    // Subcollection: users/{userId}/videoJobs
    // Document ID: {jobId}
    // Fields:
    //   - id: string
    //   - prompt: string
    //   - engine: string
    //   - status: string
    //   - videoUrl: string
    //
    // Subcollection: users/{userId}/agents
    // Document ID: {agentId}
    // Fields:
    //   - id: string
    //   - name: string
    //   - role: string
    //   - systemPrompt: string
    //   - status: string
    //
    // Collection: auditLogs
    // Document ID: {logId}
    // Fields:
    //   - type: string
    //   - campaignId: string
    //   - userId: string
    //   - status: string
    //   - timestamp: string
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userTier == 'agency') ||
          (request.auth.token.email == "justinelgua@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUser(data) {
      return data.tokens is number &&
             data.userTier in ['free', 'pro', 'agency'] &&
             (!('customGeminiKey' in data) || data.customGeminiKey is string);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.tokens <= 500;
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.tokens == resource.data.tokens) || isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
